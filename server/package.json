{
  "name": "canvaso-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env --env-file=.env.clerk src/index.js",
    "start": "node --env-file=.env --env-file=.env.clerk src/index.js",
    "db:migrate": "node --env-file=.env src/migrate.js",
    "db:seed": "node --env-file=.env src/seed.cjs",
    "check": "node --check src/index.js && node --check src/routes.js"
  },
  "dependencies": {
    "@clerk/express": "^1.7.54",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  }
}
